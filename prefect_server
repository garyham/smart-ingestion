#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

export PREFECT_API_URL="${PREFECT_API_URL:-http://127.0.0.1:4200/api}"

server_running() {
  curl -sf "$PREFECT_API_URL/health" >/dev/null 2>&1
}

action="${1:-start}"

case "$action" in
  start)
    uv run prefect server start
    ;;
  stop)
    if server_running; then
      uv run prefect server stop
    else
      echo "Prefect server is not running."
    fi
    ;;
  *)
    echo "Usage: $0 [start|stop]" >&2
    exit 1
    ;;
esac
